# TruthLens Environment Variables Template
# =====================================================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env   (Linux/macOS/Git Bash)
#   copy .env.example .env (Windows Command Prompt)
#
# IMPORTANT: Never commit the .env file — it is listed in .gitignore.
# =====================================================================


# ── Google Gemini API Key (for Deep Reasoning mode) ──────────────────
# Used by: backend/reasoning.py
# Get yours at: https://aistudio.google.com/app/apikey
# If left empty, the app falls back to local classifier reasoning.
GEMINI_API_KEY=your_gemini_api_key_here


# ── Google Fact Check Tools API Key ──────────────────────────────────
# Used by: backend/factcheck.py
# Enable 'Fact Check Tools API' at: https://console.cloud.google.com/apis
# Create an API key under APIs & Services → Credentials (free tier).
# If left empty, TruthLens falls back to the local seeded dataset.
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_api_key_here


# ── Google Custom Search API Key (optional) ──────────────────────────
# Used by: backend/search.py
# Enable 'Custom Search JSON API' at: https://console.cloud.google.com/apis
# If left empty, TruthLens falls back to DuckDuckGo HTML scraping.
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here


# ── Google Custom Search Engine ID (optional) ────────────────────────
# Used by: backend/search.py (paired with GOOGLE_SEARCH_API_KEY)
# Create a Programmable Search Engine at: https://programmablesearchengine.google.com/
GOOGLE_SEARCH_CX_ID=your_programmable_search_engine_cx_id_here


# ── Anthropic Claude API Key (optional, for richer explanations) ──────
# Used by: backend/reasoning.py (fallback after Gemini)
# Get yours at: https://console.anthropic.com/
# If left empty, TruthLens uses Gemini or local reasoning.
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# ── Translation Model Preloading ──────────────────────────────────────
# Used by: backend/translate.py
# Set to true to preload Helsinki-NLP translation models on startup.
# This increases startup time but reduces first-request latency.
# Recommended: false for development, true for production deployments.
PRELOAD_TRANSLATION_MODELS=false
